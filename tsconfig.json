{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "lib": [
      "ES2015"
    ],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "nakama-runtime"
    ]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.json",
    "shared/battle-geometry.js"
  ]
}
