{
  "name": "towerdef",
  "version": "0.1.0",
  "private": true,
  "description": "폐품로봇 원정대 — 우주 고철 수거·조립 협동 디펜스 개발 프로토타입",
  "scripts": {
    "validate:content": "node tools/validate-content.mjs",
    "build": "npm run validate:content && tsc && node tools/build-nakama.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node tools/dev-server.mjs",
    "check": "npm test",
    "test:browser": "node tools/browser-smoke.mjs",
    "test:quality": "node tools/browser-quality.mjs",
    "test:mobile": "node tools/mobile-layout.mjs",
    "test:expedition": "node tools/expedition-browser-check.mjs",
    "test:combat": "node tools/combat-feel-check.mjs",
    "test:position": "node tools/position-combat-check.mjs",
    "test:flow": "node tools/mobile-flow-check.mjs",
    "test:network": "npm run build && node tools/network-playtest.mjs",
    "simulate": "npm run build && node tools/simulate.mjs"
  },
  "devDependencies": {
    "agent-browser": "0.38.1",
    "esbuild": "0.25.12",
    "nakama-runtime": "https://codeload.github.com/heroiclabs/nakama-common/tar.gz/c8c9cd07ce975bd4bfd4e7ddb3455ca4b6f61e9d",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
